# Variables d'environnement Pilar — copier en .env pour le dev local
# Sur Railway : configurer dans Settings > Variables

# OBLIGATOIRE — cle Flask pour les sessions (generer avec: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changez-moi-en-prod

# Base de donnees (Railway la fournit automatiquement)
DATABASE_URL=postgresql://user:password@host:5432/pilar

# Email Gmail (App Password Google — pas le mot de passe principal)
GMAIL_ADDRESS=votre@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# URL publique de l'app (pour les liens dans les emails)
APP_URL=https://votre-app.railway.app

# Email admin (recoit les droits admin au premier lancement)
ADMIN_EMAIL=admin@votreentreprise.com

# Environnement (Railway le set automatiquement)
# RAILWAY_ENVIRONMENT=production

# Dev uniquement — activer le mode debug Flask
# FLASK_DEBUG=1
