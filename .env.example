# Variables d'environnement Pilar — copier en .env pour le dev local
# Sur Railway : configurer dans Settings > Variables

# OBLIGATOIRE — cle Flask pour les sessions
# Generer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-moi-en-prod

# Base de donnees (Railway la fournit automatiquement)
DATABASE_URL=postgresql://user:password@host:5432/pilar

# Email Gmail (App Password Google — pas le mot de passe principal)
GMAIL_ADDRESS=votre@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email de l'administrateur (recoit les demandes machines, droits admin au premier lancement)
ADMIN_EMAIL=admin@votreentreprise.com

# SuperUser permanent (admin+pro lifetime, doit exister en base)
SUPER_USER_EMAIL=

# Claude AI (Anthropic) — optionnel, active le chat IA
ANTHROPIC_API_KEY=sk-ant-...

# URL publique de l'app (pour les liens dans les emails)
APP_URL=https://votre-app.railway.app

# Relay email (optionnel — pour envoyer des emails en mode desktop sans GMAIL configure)
EMAIL_RELAY_URL=
EMAIL_RELAY_KEY=

# URL de verification des mises a jour (optionnel)
# Par defaut pointe vers GitHub Releases de CYPHR007/PILAR
PILAR_UPDATE_URL=

# MQTT — URL de l'app pour le listener capteurs
PILAR_URL=http://127.0.0.1:5000/predire

# Sync client (optionnel)
PILAR_SYNC_URL=
PILAR_CLIENT_ID=
PILAR_CLIENT_SECRET=

# Environnement (Railway le set automatiquement)
# RAILWAY_ENVIRONMENT=production

# Dev uniquement — activer le mode debug Flask
# FLASK_DEBUG=1
